    <!-- views/account_move_views.xml -->
    <record model="ir.ui.view" id="view_move_form_inherit_margin">
        <field name="name">account.move.form.inherit.margin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <label for="total_margin" groups="base.group_user"/>
                <div class="text-nowrap" groups="base.group_user">
                    <field name="total_margin" class="oe_inline" />
                    
                    
                    (<field name="margin_percent" widget="float" options="{'precision': 3}"
                                   nolabel="1" 
                                   style="display: inline-block; width: auto;"/>%)
                </div>
            </xpath>
        </field>
    </record>

    <!-- views/account_move_list_margin.xml -->

    <record id="view_move_tree_inherit_margin" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.margin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="total_cost" string="Total Cost" widget="monetary" options="{'precision': 3}" optional="hide"/>
                <field name="total_margin" string="Margin" widget="monetary" options="{'precision': 3}" optional="hide" />
            </xpath>
        </field>
    </record>



</odoo>
